# Copiar a .env.local y completar. Estos dos valores salen de
# Supabase -> Project Settings -> API. Son públicos por diseño:
# la seguridad la da Row Level Security, no el secreto de la llave.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# NUNCA poner aquí la secret key (sb_secret_...): este archivo termina
# compilado dentro del navegador y quedaría a la vista de cualquiera.
