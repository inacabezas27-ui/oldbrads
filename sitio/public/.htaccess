# Old Brads — oldbrads.cl (sitio estático, una sola página)

# 1) Forzar HTTPS y dominio canónico sin www (www.oldbrads.cl → oldbrads.cl)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# 2) Cualquier ruta inexistente muestra la portada (sin rewrite: mantiene el código 404 para buscadores)
ErrorDocument 404 /index.html

# 3) Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml application/ld+json
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# 4) Caché: assets con hash (Vite) e imágenes por 1 año; index.html siempre revalida
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|webp|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # 5) Cabeceras de seguridad básicas
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# 6) Tipos MIME por si el servidor no los trae
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/javascript .js .mjs
  AddType font/woff2 .woff2
</IfModule>

# 7) Sin listado de directorios ni acceso a archivos ocultos
Options -Indexes
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<Files ".htaccess">
  Require all denied
</Files>
